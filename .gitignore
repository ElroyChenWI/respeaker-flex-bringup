# PlatformIO
firmware/**/.pio/
firmware/**/.vscode/

# Python
__pycache__/
*.pyc
.venv/

# vendored upstream (scripts/fetch_vendor.ps1)
third_party/*
!third_party/README.md

# captures: recordings and flash dumps stay local (they can contain voices / firmware).
# Explicit names only - Windows git is case-insensitive, so "R*" would also match "rec_*".
captures/*
!captures/README.md
!captures/R001_com8_factory_10s.bin

# downloaded host tools (dfu-util etc.)
tools/

# personal prep notes (not published)
prep/
